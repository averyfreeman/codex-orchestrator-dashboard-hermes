{
  "name": "codex-orchestrator-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "exec node scripts/serve-dashboard.mjs dev",
    "build": "next build",
    "start": "exec node scripts/serve-dashboard.mjs start",
    "lint": "eslint",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "check:public": "python3 scripts/check_public_snapshot.py",
    "docs:dev": "npm run dev --workspace docs-site",
    "docs:check": "npm run check --workspace docs-site",
    "docs:build": "npm run build --workspace docs-site"
  },
  "workspaces": [
    "docs-site"
  ],
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "~5.7.47",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
